# Copy this file to ".env" and fill in your real values.
# .env is gitignored; .env.example is the committed template.
# These are the same values you set in Render's environment variables.

GARMIN_ENDPOINT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GARMIN_UPLOAD_TOKEN=your-shared-token

# --- Proxy pool (spreads Garmin traffic across IPs to dodge rate limits) ---
# Each participant session rotates to the next proxy. See collector/server/proxies.py
# to edit the actual proxy host lists.
GARMIN_USE_PROXY=1          # "0" to connect directly (no proxy)
USE_FREE_PROXIES=0          # "1" = free no-auth test pool; "0" = NordVPN (needs creds below)
NORDVPN_USER=               # NordVPN *service* credentials (not your account login)
NORDVPN_PASSWORD=
GARMIN_PROXY_MAX_RETRIES=3  # rotate to the next proxy this many times when one is down
GARMIN_PROXY_LOG=INFO       # log level for proxy activity (DEBUG/INFO/WARNING)
